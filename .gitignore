#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Local scratch area for staging release APKs/checksums before
# uploading to a GitHub Release - never committed, see docs/APK_UPDATE_SYSTEM.md.
/release_staging/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Downloaded/generated railway data (see scripts/ and
# docs/RAILWAY_DATABASE.md) - reproducible from source, not committed.
# assets/database/railway.db (the built result) IS committed.
/raw_data/
/build_data/

# Python venv/cache for scripts/tag2026/ (Block 6 2026-dataset extraction,
# dev-time only - never shipped, see docs/RAILWAY_DATABASE.md)
/scripts/tag2026/.venv/
__pycache__/
*.pyc
