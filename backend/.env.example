# Copy this file to .env (already gitignored - never commit the real
# one) and fill in a real RailRadar API key for local development.
#
# In production (Render), set these as the Web Service's own
# environment variables/secrets in the Render dashboard instead of a
# committed file - see docs/LIVE_STATUS.md "Deployment".

# Required. Server-only - this must never reach the Flutter app, Git,
# or any log line. Get one at https://railradar.in.
RAILRADAR_API_KEY=rr_live_your_real_key_here

# Optional - defaults shown.
RAILRADAR_BASE_URL=https://api.railradar.in
NODE_ENV=development
PORT=4000
LIVE_STATUS_CACHE_TTL_MS=25000
RAILRADAR_REQUEST_TIMEOUT_MS=8000
